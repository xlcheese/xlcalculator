msgid "Octal (base 8): digits 0-7. 17 = 15"
msgstr "Octal (base 8) : chiffres 0-7. 17 = 15"

#: usr/lib/xl-calculator/programmer.py:192
msgid "Binary (base 2): digits 0 and 1. 1010 = 10"
msgstr "Binaire (base 2) : chiffres 0 et 1. 1010 = 10"

#: usr/lib/xl-calculator/programmer.py:193
msgid ""
"Word size: click to cycle 64 → 32 → 16 → 8 bits.\n"
"Results wrap around like a real register."
msgstr ""
"Taille de mot : cliquez pour passer de 64 → 32 → 16 → 8 bits.\n"
"Les résultats reviennent au début comme dans un vrai registre."

#: usr/lib/xl-calculator/programmer.py:195
msgid ""
"Shift left: move the bits left, filling with 0.\n"
"1 << 4 = 16 (multiplies by 2 each step)"
msgstr ""
"Décalage à gauche : déplace les bits vers la gauche, en complétant par des "
"0.\n"
"1 << 4 = 16 (multiplie par 2 à chaque pas)"

#: usr/lib/xl-calculator/programmer.py:196
msgid ""
"Shift right: move the bits right, keeping the sign.\n"
"16 >> 2 = 4 (divides by 2 each step)"
msgstr ""
"Décalage à droite : déplace les bits vers la droite, en gardant le signe.\n"
"16 >> 2 = 4 (divise par 2 à chaque pas)"

#: usr/lib/xl-calculator/programmer.py:197
msgid ""
"Bitwise AND: 1 only where both bits are 1.\n"
"1100 AND 1010 = 1000"
msgstr ""
"AND bit à bit : 1 seulement là où les deux bits valent 1.\n"
"1100 AND 1010 = 1000"

#: usr/lib/xl-calculator/programmer.py:198
msgid ""
"Bitwise OR: 1 where either bit is 1.\n"
"1100 OR 1010 = 1110"
msgstr ""
"OR bit à bit : 1 là où l’un des bits vaut 1.\n"
"1100 OR 1010 = 1110"

#: usr/lib/xl-calculator/programmer.py:199
msgid ""
"Bitwise XOR: 1 where the bits differ.\n"
"1100 XOR 1010 = 0110"
msgstr ""
"XOR bit à bit : 1 là où les bits diffèrent.\n"
"1100 XOR 1010 = 0110"

#: usr/lib/xl-calculator/programmer.py:200
msgid ""
"Bitwise NOT: flip every bit of the next number.\n"
"NOT 0 = -1 (all bits set)"
msgstr ""
"NOT bit à bit : inverse tous les bits du nombre suivant.\n"
"NOT 0 = -1 (tous les bits à 1)"

#: usr/lib/xl-calculator/programmer.py:201
msgid "NOT (a AND b)"
msgstr "NOT (a AND b)"

#: usr/lib/xl-calculator/programmer.py:202
msgid "NOT (a OR b)"
msgstr "NOT (a OR b)"

#: usr/lib/xl-calculator/programmer.py:203
msgid "Remainder after whole-number division. 17 mod 5 = 2"
msgstr "Reste de la division entière. 17 mod 5 = 2"

#: usr/lib/xl-calculator/programmer.py:204
msgid "Whole-number division; the remainder is dropped. 17 ÷ 5 = 3"
msgstr "Division entière ; le reste est ignoré. 17 ÷ 5 = 3"

#: usr/lib/xl-calculator/programmer.py:205
msgid "Change the sign (two's complement negate)"
msgstr "Change le signe (négation en complément à deux)"

#: usr/lib/xl-calculator/programmer.py:227
#, python-brace-format
msgid "Can't paste that in {base}"
msgstr "Impossible de coller ceci en {base}"

#. Translators: under the Programmer display, e.g. "QWORD (64-bit, signed)  ·  typing in DEC"
#: usr/lib/xl-calculator/programmer.py:252
#, python-brace-format
msgid "{word} ({bits}-bit, signed)  ·  typing in {base}"
msgstr "{word} ({bits} bits, signé)  ·  saisie en {base}"

#: usr/lib/xl-calculator/programmer.py:435
#: usr/lib/xl-calculator/programmer.py:437
msgid "Not a whole number"
msgstr "Pas un nombre entier"

#: usr/lib/xl-calculator/scientific.py:37
msgid "round down to a whole number:  floor(2.7) = 2"
msgstr "arrondit à l’entier inférieur :  floor(2.7) = 2"

#: usr/lib/xl-calculator/scientific.py:38
msgid "round up to a whole number:  ceil(2.1) = 3"
msgstr "arrondit à l’entier supérieur :  ceil(2.1) = 3"

#: usr/lib/xl-calculator/scientific.py:39
msgid "the whole-number part:  int(−2.7) = −2"
msgstr "la partie entière :  int(−2.7) = −2"

#: usr/lib/xl-calculator/scientific.py:40
msgid "the part after the decimal point:  frac(2.75) = 0.75"
msgstr "la partie après le séparateur décimal :  frac(2.75) = 0.75"

#: usr/lib/xl-calculator/scientific.py:41
msgid "the sign:  −1, 0, or 1"
msgstr "le signe :  −1, 0 ou 1"

#: usr/lib/xl-calculator/scientific.py:42
msgid "logarithm base 2:  log₂(8) = 3"
msgstr "logarithme en base 2 :  log₂(8) = 3"

#: usr/lib/xl-calculator/scientific.py:43
msgid "secant, 1 ÷ cos"
msgstr "sécante, 1 ÷ cos"

#: usr/lib/xl-calculator/scientific.py:44
msgid "cosecant, 1 ÷ sin"
msgstr "cosécante, 1 ÷ sin"

#: usr/lib/xl-calculator/scientific.py:45
msgid "cotangent, cos ÷ sin"
msgstr "cotangente, cos ÷ sin"

#: usr/lib/xl-calculator/scientific.py:49
msgid "Absolute value: the number without its sign.  |−5| = 5"
msgstr "Valeur absolue : le nombre sans son signe.  |−5| = 5"

#: usr/lib/xl-calculator/scientific.py:50
msgid ""
"Combinations: ways to choose r items from n when order doesn't matter.\n"
"5 nCr 2 = 10"
msgstr ""
"Combinaisons : façons de choisir r éléments parmi n quand l’ordre ne compte "
"pas.\n"
"5 nCr 2 = 10"

#: usr/lib/xl-calculator/scientific.py:51
msgid ""
"Permutations: ways to arrange r items from n when order matters.\n"
"5 nPr 2 = 20"
msgstr ""
"Arrangements : façons d’ordonner r éléments parmi n quand l’ordre compte.\n"
"5 nPr 2 = 20"

#: usr/lib/xl-calculator/scientific.py:52
msgid "Round to the nearest whole number.  round(2.5) = 3"
msgstr "Arrondit à l’entier le plus proche.  round(2.5) = 3"

#: usr/lib/xl-calculator/scientific.py:53
msgid "More functions"
msgstr "Autres fonctions"

#: usr/lib/xl-calculator/scientific.py:54
msgid "Remainder after division.  17 mod 5 = 2"
msgstr "Reste de la division.  17 mod 5 = 2"

