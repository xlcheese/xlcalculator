#: usr/lib/xl-calculator/programmer.py:189
msgid "Hexadecimal (base 16): digits 0-9 and A-F. FF = 255"
msgstr "Hexadecimal (base 16): dígitos 0-9 y A-F. FF = 255"

#: usr/lib/xl-calculator/programmer.py:190
msgid "Decimal (base 10): ordinary numbers, shown with a sign"
msgstr "Decimal (base 10): números normales, con signo"

#: usr/lib/xl-calculator/programmer.py:191
msgid "Octal (base 8): digits 0-7. 17 = 15"
msgstr "Octal (base 8): dígitos 0-7. 17 = 15"

#: usr/lib/xl-calculator/programmer.py:192
msgid "Binary (base 2): digits 0 and 1. 1010 = 10"
msgstr "Binario (base 2): dígitos 0 y 1. 1010 = 10"

#: usr/lib/xl-calculator/programmer.py:193
msgid ""
"Word size: click to cycle 64 → 32 → 16 → 8 bits.\n"
"Results wrap around like a real register."
msgstr ""
"Tamaño de palabra: haga clic para pasar por 64 → 32 → 16 → 8 bits.\n"
"Los resultados dan la vuelta como en un registro real."

#: usr/lib/xl-calculator/programmer.py:195
msgid ""
"Shift left: move the bits left, filling with 0.\n"
"1 << 4 = 16 (multiplies by 2 each step)"
msgstr ""
"Desplazar a la izquierda: mueve los bits a la izquierda, rellenando con 0.\n"
"1 << 4 = 16 (multiplica por 2 en cada paso)"

#: usr/lib/xl-calculator/programmer.py:196
msgid ""
"Shift right: move the bits right, keeping the sign.\n"
"16 >> 2 = 4 (divides by 2 each step)"
msgstr ""
"Desplazar a la derecha: mueve los bits a la derecha, conservando el signo.\n"
"16 >> 2 = 4 (divide entre 2 en cada paso)"

#: usr/lib/xl-calculator/programmer.py:197
msgid ""
"Bitwise AND: 1 only where both bits are 1.\n"
"1100 AND 1010 = 1000"
msgstr ""
"AND bit a bit: 1 solo donde ambos bits son 1.\n"
"1100 AND 1010 = 1000"

#: usr/lib/xl-calculator/programmer.py:198
msgid ""
"Bitwise OR: 1 where either bit is 1.\n"
"1100 OR 1010 = 1110"
msgstr ""
"OR bit a bit: 1 donde cualquiera de los bits es 1.\n"
"1100 OR 1010 = 1110"

#: usr/lib/xl-calculator/programmer.py:199
msgid ""
"Bitwise XOR: 1 where the bits differ.\n"
"1100 XOR 1010 = 0110"
msgstr ""
"XOR bit a bit: 1 donde los bits son distintos.\n"
"1100 XOR 1010 = 0110"

#: usr/lib/xl-calculator/programmer.py:200
msgid ""
"Bitwise NOT: flip every bit of the next number.\n"
"NOT 0 = -1 (all bits set)"
msgstr ""
"NOT bit a bit: invierte todos los bits del número siguiente.\n"
"NOT 0 = -1 (todos los bits a 1)"

#: usr/lib/xl-calculator/programmer.py:201
msgid "NOT (a AND b)"
msgstr "NOT (a AND b)"

#: usr/lib/xl-calculator/programmer.py:202
msgid "NOT (a OR b)"
msgstr "NOT (a OR b)"

#: usr/lib/xl-calculator/programmer.py:203
msgid "Remainder after whole-number division. 17 mod 5 = 2"
msgstr "Resto de la división entera. 17 mod 5 = 2"

#: usr/lib/xl-calculator/programmer.py:204
msgid "Whole-number division; the remainder is dropped. 17 ÷ 5 = 3"
